<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_background"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/logo"
        android:layout_width="wrap_content"
        android:layout_height="64dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="16dp"
        android:adjustViewBounds="true"
        android:contentDescription="@string/logo_description"
        android:src="@drawable/igig_logo" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/search_layout"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="8dp"
        app:boxCornerRadiusBottomEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusTopStart="12dp"
        app:boxStrokeColor="@color/brand_orange"
        app:endIconContentDescription="@string/search_button"
        app:endIconDrawable="@drawable/ic_search"
        app:endIconMode="custom"
        app:hintEnabled="false">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/search_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/search_hint"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_types"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:selectionRequired="false"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_hotspots"
                style="@style/Widget.IGig.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/type_hotspots" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_clubs"
                style="@style/Widget.IGig.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/type_clubs" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_comedy"
                style="@style/Widget.IGig.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/type_comedy" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_restaurants"
                style="@style/Widget.IGig.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/type_restaurants" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_parks"
                style="@style/Widget.IGig.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/type_parks" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_churches"
                style="@style/Widget.IGig.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/type_churches" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/search_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorColor="@color/brand_orange" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1">

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/explore_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/view_toggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="16dp"
            app:checkedButton="@+id/btn_map"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_map"
                style="@style/Widget.IGig.ToggleButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/view_map"
                app:icon="@drawable/ic_map" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_list"
                style="@style/Widget.IGig.ToggleButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/view_list"
                app:icon="@drawable/ic_list" />
        </com.google.android.material.button.MaterialButtonToggleGroup>
    </FrameLayout>

</LinearLayout>